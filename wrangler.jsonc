{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bot-factory",
  "main": "worker.js",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // Public non-secret variables — override per environment or in Cloudflare Dashboard
  "vars": {
    "ENVIRONMENT": "production",
    "WORKER_PUBLIC_URL": "https://bot-factory.YOUR-SUBDOMAIN.workers.dev",
    "MASTER_BOT_USERNAME": "REPLACE_WITH_MASTER_BOT_USERNAME",
    "ADMIN_TELEGRAM_ID": "REPLACE_WITH_OWNER_TELEGRAM_ID",
    "CORS_ALLOWED_ORIGINS": "*"
  },

  // Primary Relational Database: Cloudflare D1
  // Run `npx wrangler d1 create bot_factory_db` and paste your real database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bot_factory_db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  // Configuration Cache & Rate-Limit Store: Cloudflare KV
  // Run `npx wrangler kv namespace create BOT_FACTORY_KV` and paste your real id below.
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],

  // Custom Usage Telemetry: Cloudflare Workers Analytics Engine
  // Automatically provisioned when deployed to a Workers account with Analytics Engine enabled.
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "bot_factory_events"
    }
  ],

  // Scheduled cron trigger to advance active broadcast batches and aggregate usage metrics
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}
