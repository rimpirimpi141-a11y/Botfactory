# ==============================================================================
# BOT FACTORY — Environment Variables & Secrets Template
# ==============================================================================
# NEVER commit real secrets to GitHub.
# For Cloudflare Workers production, set secrets via:
#   npx wrangler secret put <SECRET_NAME>

# --- Frontend (Vite) ---
# Public URL of your deployed Cloudflare Worker (no trailing slash)
VITE_WORKER_URL="https://bot-factory.YOUR-SUBDOMAIN.workers.dev"

# --- Cloudflare Worker Public Vars (also configurable in wrangler.jsonc) ---
WORKER_PUBLIC_URL="https://bot-factory.YOUR-SUBDOMAIN.workers.dev"
MASTER_BOT_USERNAME="YourMasterBotUsername"
ADMIN_TELEGRAM_ID="123456789"
ENVIRONMENT="production"

# --- Cloudflare Worker Secrets (Set via `wrangler secret put`) ---
# Master bot token from @BotFather
MASTER_BOT_TOKEN=""
# Secret token sent in X-Telegram-Bot-Api-Secret-Token header for master bot webhook
MASTER_WEBHOOK_SECRET=""
# Base64-encoded 32-byte (256-bit) AES-GCM master key for encrypting tenant bot tokens
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
# Bearer token for accessing the Owner Admin REST API (/api/*) from the React dashboard
ADMIN_API_KEY=""

# --- Cloudflare Infrastructure Monitoring Secrets (Optional, least-privilege API token) ---
# Requires Account Analytics:Read, Workers Scripts:Read, D1:Read, Workers KV Storage:Read
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_KV_NAMESPACE_ID=""
CLOUDFLARE_WORKER_SCRIPT_NAME="bot-factory"

# --- Optional AI Utility Key (for Tool Bot AI module only when configured) ---
GEMINI_API_KEY=""
